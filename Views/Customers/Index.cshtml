@model CustomerListViewModel
@inject ChauThanhEV.Services.MockDataService DataService
@{
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["HeaderTag"] = "30 tài khoản khách hàng thành viên • Châu Thành EV";
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) routeValues["keyword"] = Model.Keyword;
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeValues["status"] = Model.StatusFilter;

    var totalCust = DataService.Customers.Count;
    var activeCust = DataService.Customers.Count(c => c.Status == CustomerStatus.Active);
    var totalWallet = DataService.Customers.Sum(c => c.WalletBalance);
    var totalRfid = DataService.Cards.Count;
}

<!-- KPI Metric Cards Strip -->
<div class="subpage-kpi-grid">
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-blue">👤</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tổng số khách hàng</div>
            <div class="subpage-kpi-val">@totalCust <span style="font-size:13px; font-weight:600; color:#64748b;">thành viên</span></div>
            <div class="subpage-kpi-sub">Đăng ký sử dụng dịch vụ</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-green">🟢</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tài khoản hoạt động</div>
            <div class="subpage-kpi-val">@activeCust <span style="font-size:13px; font-weight:600; color:#64748b;">tài khoản</span></div>
            <div class="subpage-kpi-sub">@((activeCust * 100.0 / totalCust).ToString("0.0"))% hoạt động bình thường</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-orange">💰</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tổng số dư ví khách hàng</div>
            <div class="subpage-kpi-val" style="font-size: 17px;">@ChauThanhEV.Services.MockDataService.FormatCurrency(totalWallet)</div>
            <div class="subpage-kpi-sub">Số dư khả dụng sạc xe</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-purple">💳</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Thẻ RFID đã liên kết</div>
            <div class="subpage-kpi-val">@totalRfid <span style="font-size:13px; font-weight:600; color:#64748b;">thẻ</span></div>
            <div class="subpage-kpi-sub">Quẹt thẻ tự động tại trụ sạc</div>
        </div>
    </div>
</div>

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo mã KH, họ tên, số điện thoại..." />
    </form>

    <form method="get" class="filter-select-form">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <input type="hidden" name="keyword" value="@Model.Keyword" />
        }
        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">Tất cả trạng thái</option>
            <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang hoạt động</option>
            <option value="Locked" selected="@(Model.StatusFilter == "Locked")">Đã khóa</option>
        </select>
    </form>

    <div class="toolbar-actions">
        <button type="button" class="btn btn-outline" data-export-csv="customerTable" data-export-name="danh-sach-khach-hang-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất CSV
        </button>
        <button type="button" class="btn btn-outline" data-export-excel="customerTable" data-export-name="danh-sach-khach-hang-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất Excel
        </button>
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-create-customer">
            @await Html.PartialAsync("_Icon", "plus") Thêm khách hàng
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="customerTable">
            <thead>
                <tr>
                    <th>Mã KH</th>
                    <th>Họ tên</th>
                    <th>Điện thoại</th>
                    <th>Email</th>
                    <th>Số dư ví</th>
                    <th>Trạng thái</th>
                    <th>Ngày đăng ký</th>
                    <th class="no-export">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr class="empty-row"><td colspan="8">Không tìm thấy khách hàng phù hợp.</td></tr>
                }
                @foreach (var c in Model.Result.Items)
                {
                    <tr>
                        <td><strong>@c.Code</strong></td>
                        <td>@c.FullName</td>
                        <td>@c.Phone</td>
                        <td>@c.Email</td>
                        <td>@ChauThanhEV.Services.MockDataService.FormatCurrency(c.WalletBalance)</td>
                        <td>
                            @if (c.Status == CustomerStatus.Active)
                            {
                                <span class="pill pill-green">Hoạt động</span>
                            }
                            else
                            {
                                <span class="pill pill-gray">Đã khóa</span>
                            }
                        </td>
                        <td>@c.RegisteredAt.ToString("dd/MM/yyyy")</td>
                        <td class="no-export">
                            <div class="cell-actions">
                                <button type="button" class="btn btn-ghost btn-sm" data-open-modal="modal-view-customer-@c.Id" title="Xem chi tiết">@await Html.PartialAsync("_Icon", "eye")</button>
                                <button type="button" class="btn btn-ghost btn-sm" data-open-modal="modal-edit-customer-@c.Id" title="Sửa">@await Html.PartialAsync("_Icon", "edit")</button>
                                <button type="button" class="btn btn-ghost btn-sm" data-open-modal="modal-balance-customer-@c.Id" title="Điều chỉnh ví">@await Html.PartialAsync("_Icon", "refund")</button>
                                <form asp-action="Delete" method="post" data-confirm="Xóa khách hàng @c.FullName khỏi hệ thống?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Xóa">@await Html.PartialAsync("_Icon", "trash")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        TotalItems = Model.Result.TotalItems,
        PageSize = Model.Result.PageSize,
        Controller = "Customers",
        Action = "Index",
        RouteValues = routeValues
    })
</div>

<!-- Modal: Thêm khách hàng -->
<div class="modal-overlay" id="modal-create-customer">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Thêm khách hàng mới</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="Customers" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field full">
                        <label>Họ và tên</label>
                        <input type="text" name="FullName" required placeholder="Nguyễn Văn A" />
                    </div>
                    <div class="form-field">
                        <label>Số điện thoại</label>
                        <input type="tel" name="Phone" required placeholder="09xxxxxxxx" />
                    </div>
                    <div class="form-field">
                        <label>Email</label>
                        <input type="email" name="Email" placeholder="ten@gmail.com" />
                    </div>
                    <div class="form-field">
                        <label>Số dư ví ban đầu (đ)</label>
                        <input type="number" name="WalletBalance" value="0" min="0" step="1000" />
                    </div>
                    <div class="form-field">
                        <label>Trạng thái</label>
                        <select name="Status">
                            <option value="Active">Đang hoạt động</option>
                            <option value="Locked">Đã khóa</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                <button type="submit" class="btn btn-primary-sm">Lưu khách hàng</button>
            </div>
        </form>
    </div>
</div>

@foreach (var c in Model.Result.Items)
{
    <!-- Modal: Xem chi tiết -->
    <div class="modal-overlay" id="modal-view-customer-@c.Id">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Chi tiết khách hàng @c.Code</h3>
                <button type="button" class="modal-close" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <div class="detail-item"><label>Họ tên</label><p>@c.FullName</p></div>
                    <div class="detail-item"><label>Số điện thoại</label><p>@c.Phone</p></div>
                    <div class="detail-item"><label>Email</label><p>@c.Email</p></div>
                    <div class="detail-item"><label>Số dư ví</label><p>@ChauThanhEV.Services.MockDataService.FormatCurrency(c.WalletBalance)</p></div>
                    <div class="detail-item"><label>Trạng thái</label><p>@(c.Status == CustomerStatus.Active ? "Đang hoạt động" : "Đã khóa")</p></div>
                    <div class="detail-item"><label>Ngày đăng ký</label><p>@c.RegisteredAt.ToString("dd/MM/yyyy")</p></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Đóng</button>
            </div>
        </div>
    </div>

    <!-- Modal: Sửa khách hàng -->
    <div class="modal-overlay" id="modal-edit-customer-@c.Id">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Sửa thông tin khách hàng @c.Code</h3>
                <button type="button" class="modal-close" data-close-modal>&times;</button>
            </div>
            <form asp-controller="Customers" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@c.Id" />
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-field full">
                            <label>Họ và tên</label>
                            <input type="text" name="FullName" value="@c.FullName" required />
                        </div>
                        <div class="form-field">
                            <label>Số điện thoại</label>
                            <input type="tel" name="Phone" value="@c.Phone" required />
                        </div>
                        <div class="form-field">
                            <label>Email</label>
                            <input type="email" name="Email" value="@c.Email" />
                        </div>
                        <div class="form-field">
                            <label>Số dư ví (đ)</label>
                            <input type="number" name="WalletBalance" value="@((long)c.WalletBalance)" min="0" step="1000" />
                        </div>
                        <div class="form-field">
                            <label>Trạng thái</label>
                            <select name="Status">
                                <option value="Active" selected="@(c.Status == CustomerStatus.Active)">Đang hoạt động</option>
                                <option value="Locked" selected="@(c.Status == CustomerStatus.Locked)">Đã khóa</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                    <button type="submit" class="btn btn-primary-sm">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Điều chỉnh số dư ví -->
    <div class="modal-overlay" id="modal-balance-customer-@c.Id">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Điều chỉnh ví — @c.FullName</h3>
                <button type="button" class="modal-close" data-close-modal>&times;</button>
            </div>
            <form asp-controller="Customers" asp-action="AdjustBalance" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CustomerId" value="@c.Id" />
                <div class="modal-body">
                    <p class="form-hint" style="margin-bottom:12px;">Số dư hiện tại: <strong>@ChauThanhEV.Services.MockDataService.FormatCurrency(c.WalletBalance)</strong></p>
                    <div class="form-grid">
                        <div class="form-field full">
                            <label>Số tiền điều chỉnh (đ)</label>
                            <input type="number" name="Amount" value="0" step="1000" required />
                            <p class="form-hint">Nhập số dương để cộng tiền, số âm để trừ tiền (vd: -50000).</p>
                        </div>
                        <div class="form-field full">
                            <label>Ghi chú</label>
                            <textarea name="Note" placeholder="Lý do điều chỉnh..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                    <button type="submit" class="btn btn-primary-sm">Xác nhận điều chỉnh</button>
                </div>
            </form>
        </div>
    </div>
}

@model FinancialViewModel
@{
    ViewData["Title"] = "Quản lý tài chính";
    ViewData["HeaderTag"] = "Báo cáo doanh thu & Đối soát tài chính 90 ngày";
}

<!-- KPI Metric Cards Strip -->
<div class="subpage-kpi-grid">
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-green">💰</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tổng thu nhập kỳ 90 ngày</div>
            <div class="subpage-kpi-val" style="font-size: 18px;">@ChauThanhEV.Services.MockDataService.FormatCurrency(Model.Overview.TotalIncome)</div>
            <div class="subpage-kpi-sub">Doanh thu sạc xe & dịch vụ</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-blue">📅</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Thu nhập hôm nay</div>
            <div class="subpage-kpi-val" style="font-size: 18px;">@ChauThanhEV.Services.MockDataService.FormatCurrency(Model.Overview.TodayIncome)</div>
            <div class="subpage-kpi-sub">Phát sinh trong ngày</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-orange">⚡</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Thu nhập tháng này</div>
            <div class="subpage-kpi-val" style="font-size: 18px;">@ChauThanhEV.Services.MockDataService.FormatCurrency(Model.Overview.ThisMonthIncome)</div>
            <div class="subpage-kpi-sub">Tăng trưởng ổn định</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-purple">💳</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Số dư khả dụng để rút</div>
            <div class="subpage-kpi-val" style="font-size: 18px;">@ChauThanhEV.Services.MockDataService.FormatCurrency(Model.Overview.AvailableBalance)</div>
            <div class="subpage-kpi-sub">Sẵn sàng đối soát ngân hàng</div>
        </div>
    </div>
</div>

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo mã giao dịch / loại giao dịch..." />
    </form>
    <div class="toolbar-actions">
        <button type="button" class="btn btn-outline" data-export-csv="financialTable" data-export-name="lich-su-giao-dich-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất CSV
        </button>
        <button type="button" class="btn btn-outline" data-export-excel="financialTable" data-export-name="lich-su-giao-dich-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất Excel
        </button>
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-withdraw">
            @await Html.PartialAsync("_Icon", "refund") Rút tiền
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="financialTable">
            <thead>
                <tr>
                    <th>Mã giao dịch</th>
                    <th>Thời gian</th>
                    <th>Loại giao dịch</th>
                    <th>Số tiền</th>
                    <th>Số dư sau giao dịch</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Transactions.Items.Any())
                {
                    <tr class="empty-row"><td colspan="5">Không có giao dịch nào.</td></tr>
                }
                @foreach (var tx in Model.Transactions.Items)
                {
                    <tr>
                        <td><strong>@tx.TransactionId</strong></td>
                        <td>@tx.TransactionTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@tx.TransactionType</td>
                        <td>@ChauThanhEV.Services.MockDataService.FormatCurrency(tx.Amount)</td>
                        <td>@ChauThanhEV.Services.MockDataService.FormatCurrency(tx.BalanceAfter)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Transactions.Page,
        TotalPages = Model.Transactions.TotalPages,
        TotalItems = Model.Transactions.TotalItems,
        PageSize = Model.Transactions.PageSize,
        Controller = "FinancialManagement",
        Action = "Index",
        RouteValues = new Dictionary<string, string>()
    })
</div>

<div class="modal-overlay" id="modal-withdraw">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Yêu cầu rút tiền</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="FinancialManagement" asp-action="Withdraw" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field full">
                        <label>Số tiền cần rút (VNĐ)</label>
                        <input type="number" name="amount" min="10000" step="10000" placeholder="Nhập số tiền cần rút" required />
                    </div>
                    <div class="form-field full">
                        <label>Tài khoản ngân hàng nhận tiền</label>
                        <input type="text" name="bankAccount" placeholder="Số tài khoản - Ngân hàng (Vd: 1903... Techcombank)" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                <button type="submit" class="btn btn-primary-sm">Xác nhận rút tiền</button>
            </div>
        </form>
    </div>
</div>

@model StationListViewModel
@inject ChauThanhEV.Services.MockDataService DataService
@{
    ViewData["Title"] = "Quản lý trạm sạc";
    ViewData["HeaderTag"] = "Hệ thống 5 trạm cao tốc • 40 trụ DC • 80 cổng CCS2";
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) routeValues["keyword"] = Model.Keyword;
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeValues["status"] = Model.StatusFilter;

    var totalStations = DataService.Stations.Count;
    var activeStations = DataService.Stations.Count(s => s.Active);
    var totalChargers = DataService.Chargers.Count;
    var totalConnectors = DataService.Chargers.SelectMany(c => c.Connectors).Count();
}

<!-- KPI Metric Cards Strip -->
<div class="subpage-kpi-grid">
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-blue">🏢</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tổng số trạm sạc</div>
            <div class="subpage-kpi-val">@totalStations <span style="font-size:13px; font-weight:600; color:#64748b;">trạm</span></div>
            <div class="subpage-kpi-sub">@activeStations trạm đang hoạt động (100%)</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-green">⚡</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Quy mô trụ sạc DC</div>
            <div class="subpage-kpi-val">@totalChargers <span style="font-size:13px; font-weight:600; color:#64748b;">trụ</span></div>
            <div class="subpage-kpi-sub">8 trụ/trạm (4x160kW + 4x240kW)</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-orange">🔌</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tổng cổng sạc CCS2</div>
            <div class="subpage-kpi-val">@totalConnectors <span style="font-size:13px; font-weight:600; color:#64748b;">cổng</span></div>
            <div class="subpage-kpi-sub">2 cổng sạc nhanh / trụ</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-purple">💰</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Giá điện niêm yết</div>
            <div class="subpage-kpi-val">3.800 <span style="font-size:13px; font-weight:600; color:#64748b;">đ/kWh</span></div>
            <div class="subpage-kpi-sub">Áp dụng đồng bộ toàn mạng lưới</div>
        </div>
    </div>
</div>

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo mã trạm, tên trạm, tuyến cao tốc..." />
    </form>

    <form method="get" class="filter-select-form">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <input type="hidden" name="keyword" value="@Model.Keyword" />
        }
        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">Tất cả trạng thái</option>
            <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang hoạt động</option>
            <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Tạm dừng</option>
        </select>
    </form>

    <div class="toolbar-actions">
        <button type="button" class="btn btn-outline" data-export-csv="stationTable" data-export-name="danh-sach-tram-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất CSV
        </button>
        <button type="button" class="btn btn-outline" data-export-excel="stationTable" data-export-name="danh-sach-tram-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất Excel
        </button>
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-create-station">
            @await Html.PartialAsync("_Icon", "plus") Thêm trạm
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="stationTable">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Mã trạm</th>
                    <th>Tên trạm sạc</th>
                    <th>Vị trí tuyến cao tốc</th>
                    <th>Múi giờ</th>
                    <th>Quy mô trụ DC</th>
                    <th>Cổng CCS2</th>
                    <th>Giá điện</th>
                    <th>Trạng thái</th>
                    <th class="no-export">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr class="empty-row"><td colspan="10">Không tìm thấy trạm phù hợp.</td></tr>
                }
                @for (int i = 0; i < Model.Result.Items.Count; i++)
                {
                    var station = Model.Result.Items[i];
                    var stChargers = DataService.Chargers.Where(c => c.StationId == station.Id).ToList();
                    var chargerCount = stChargers.Count;
                    var connectorCount = stChargers.Sum(c => c.Connectors.Count);
                    var totalKw = stChargers.Sum(c => c.PowerKw);
                    <tr>
                        <td>@((Model.Result.Page - 1) * Model.Result.PageSize + i + 1)</td>
                        <td><strong class="color-blue">@station.Code</strong></td>
                        <td><strong>@station.Name</strong></td>
                        <td class="wrap">@station.Address</td>
                        <td>@station.TimeZone</td>
                        <td>
                            <strong>@chargerCount trụ DC</strong>
                            <span style="font-size:11.5px; color:#64748b; display:block;">(@totalKw.ToString("N0") kW)</span>
                        </td>
                        <td>
                            <strong>@connectorCount cổng</strong>
                            <span style="font-size:11.5px; color:#0284c7; display:block;">CCS2 Fast</span>
                        </td>
                        <td>@ChauThanhEV.Services.MockDataService.FormatCurrency(station.DefaultElectricityPrice)/kWh</td>
                        <td>
                            <span class="pill @(station.Active ? "pill-green" : "pill-gray")">@(station.Active ? "Đang hoạt động" : "Tạm dừng")</span>
                        </td>
                        <td class="no-export">
                            <div class="cell-actions">
                                <button type="button" class="btn btn-ghost btn-sm" data-open-modal="modal-edit-station-@station.Id" title="Sửa thông tin trạm">@await Html.PartialAsync("_Icon", "edit")</button>
                                <form asp-action="Delete" asp-controller="Stations" method="post" data-confirm="Xóa trạm @station.Name khỏi hệ thống?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@station.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Xóa">@await Html.PartialAsync("_Icon", "trash")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        TotalItems = Model.Result.TotalItems,
        PageSize = Model.Result.PageSize,
        Controller = "Stations",
        Action = "Index",
        RouteValues = routeValues
    })
</div>

<div class="modal-overlay" id="modal-create-station">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Thêm trạm sạc mới</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="Stations" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field full">
                        <label>Tên trạm sạc</label>
                        <input type="text" name="Name" required placeholder="Nhập tên trạm sạc" />
                    </div>
                    <div class="form-field full">
                        <label>Vị trí / Địa chỉ</label>
                        <input type="text" name="Address" required placeholder="Km..., cao tốc..." />
                    </div>
                    <div class="form-field">
                        <label>Múi giờ</label>
                        <input type="text" name="TimeZone" value="Asia/Ho_Chi_Minh" />
                    </div>
                    <div class="form-field">
                        <label>Giá điện mặc định (VNĐ/kWh)</label>
                        <input type="number" name="DefaultElectricityPrice" value="3800" min="0" step="100" />
                    </div>
                    <div class="form-field full">
                        <label>Trạng thái</label>
                        <select name="Active">
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Tạm dừng</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                <button type="submit" class="btn btn-primary-sm">Lưu trạm</button>
            </div>
        </form>
    </div>
</div>

@foreach (var station in Model.Result.Items)
{
    <div class="modal-overlay" id="modal-edit-station-@station.Id">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Sửa thông tin trạm @station.Code</h3>
                <button type="button" class="modal-close" data-close-modal>&times;</button>
            </div>
            <form asp-controller="Stations" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@station.Id" />
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-field full">
                            <label>Tên trạm sạc</label>
                            <input type="text" name="Name" value="@station.Name" required />
                        </div>
                        <div class="form-field full">
                            <label>Vị trí / Địa chỉ</label>
                            <input type="text" name="Address" value="@station.Address" required />
                        </div>
                        <div class="form-field">
                            <label>Múi giờ</label>
                            <input type="text" name="TimeZone" value="@station.TimeZone" />
                        </div>
                        <div class="form-field">
                            <label>Giá điện mặc định (VNĐ/kWh)</label>
                            <input type="number" name="DefaultElectricityPrice" value="@station.DefaultElectricityPrice" min="0" step="100" />
                        </div>
                        <div class="form-field full">
                            <label>Trạng thái</label>
                            <select name="Active">
                                <option value="true" selected="@(station.Active)">Đang hoạt động</option>
                                <option value="false" selected="@(!station.Active)">Tạm dừng</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                    <button type="submit" class="btn btn-primary-sm">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
}

@model ReservationListViewModel
@{
    ViewData["Title"] = "Reservation";
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) routeValues["keyword"] = Model.Keyword;
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeValues["status"] = Model.StatusFilter;
}

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo mã đặt chỗ, khách hàng, trụ..." />
    </form>

    <form method="get" class="filter-select-form">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <input type="hidden" name="keyword" value="@Model.Keyword" />
        }
        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">Tất cả trạng thái</option>
            <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
            <option value="Expired" selected="@(Model.StatusFilter == "Expired")">Expired</option>
            <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
        </select>
    </form>

    <div class="toolbar-actions">
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-create-reservation">
            @await Html.PartialAsync("_Icon", "plus") Add Reservation
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="reservationTable">
            <thead>
                <tr>
                    <th>Reservation ID</th>
                    <th>User</th>
                    <th>Charger</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr class="empty-row"><td colspan="6">Không có đặt chỗ nào.</td></tr>
                }
                @foreach (var reservation in Model.Result.Items)
                {
                    <tr>
                        <td><strong>@reservation.ReservationId</strong></td>
                        <td>@reservation.UserName</td>
                        <td>@reservation.ChargerCode</td>
                        <td>@reservation.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@reservation.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (reservation.Status == ReservationStatus.Active)
                            {
                                <span class="pill pill-green">Active</span>
                            }
                            else if (reservation.Status == ReservationStatus.Expired)
                            {
                                <span class="pill pill-gray">Expired</span>
                            }
                            else
                            {
                                <span class="pill pill-red">Cancelled</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        TotalItems = Model.Result.TotalItems,
        PageSize = Model.Result.PageSize,
        Controller = "Reservations",
        Action = "Index",
        RouteValues = routeValues
    })
</div>

<div class="modal-overlay" id="modal-create-reservation">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Thêm Reservation</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="Reservations" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label>User</label>
                        <select name="UserId">
                            @foreach (var u in Model.Customers)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Charger</label>
                        <select name="ChargerId">
                            @foreach (var c in Model.Chargers)
                            {
                                <option value="@c.Id">@c.Code - @c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-field"><label>Start Date/Time</label><input type="datetime-local" name="StartTime" value="@DateTime.Now.AddHours(2).ToString("yyyy-MM-ddTHH:mm")" /></div>
                    <div class="form-field"><label>Duration (minutes)</label><input type="number" name="DurationMinutes" value="60" min="30" step="15" /></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary-sm">Confirm</button>
            </div>
        </form>
    </div>
</div>

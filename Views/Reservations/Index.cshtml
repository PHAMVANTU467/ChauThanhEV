@model ReservationListViewModel
@{
    ViewData["Title"] = "Quản lý đặt trước";
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) routeValues["keyword"] = Model.Keyword;
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeValues["status"] = Model.StatusFilter;
}

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo mã đặt chỗ, khách hàng, trụ..." />
    </form>

    <form method="get" class="filter-select-form">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <input type="hidden" name="keyword" value="@Model.Keyword" />
        }
        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">Tất cả trạng thái</option>
            <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang hiệu lực</option>
            <option value="Expired" selected="@(Model.StatusFilter == "Expired")">Hết hạn</option>
            <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Đã hủy</option>
        </select>
    </form>

    <div class="toolbar-actions">
        <button type="button" class="btn btn-outline" data-export-csv="reservationTable" data-export-name="danh-sach-dat-truoc">
            @await Html.PartialAsync("_Icon", "download") Xuất CSV
        </button>
        <button type="button" class="btn btn-outline" data-export-excel="reservationTable" data-export-name="danh-sach-dat-truoc">
            @await Html.PartialAsync("_Icon", "download") Xuất Excel
        </button>
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-create-reservation">
            @await Html.PartialAsync("_Icon", "plus") Thêm đặt trước
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="reservationTable">
            <thead>
                <tr>
                    <th>Mã đặt trước</th>
                    <th>Khách hàng</th>
                    <th>Trụ sạc</th>
                    <th>Thời gian bắt đầu</th>
                    <th>Thời gian kết thúc</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr class="empty-row"><td colspan="6">Không có lượt đặt trước nào.</td></tr>
                }
                @foreach (var reservation in Model.Result.Items)
                {
                    <tr>
                        <td><strong>@reservation.ReservationId</strong></td>
                        <td>@reservation.UserName</td>
                        <td>@reservation.ChargerCode</td>
                        <td>@reservation.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@reservation.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (reservation.Status == ReservationStatus.Active)
                            {
                                <span class="pill pill-green">Đang hiệu lực</span>
                            }
                            else if (reservation.Status == ReservationStatus.Expired)
                            {
                                <span class="pill pill-gray">Hết hạn</span>
                            }
                            else
                            {
                                <span class="pill pill-red">Đã hủy</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        TotalItems = Model.Result.TotalItems,
        PageSize = Model.Result.PageSize,
        Controller = "Reservations",
        Action = "Index",
        RouteValues = routeValues
    })
</div>

<div class="modal-overlay" id="modal-create-reservation">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Thêm lượt đặt trước mới</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="Reservations" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label>Khách hàng</label>
                        <select name="UserId">
                            @foreach (var u in Model.Customers)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Trụ sạc</label>
                        <select name="ChargerCode">
                            @foreach (var c in Model.Chargers)
                            {
                                <option value="@c.Code">@c.Code (@c.Name)</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Thời gian bắt đầu</label>
                        <input type="datetime-local" name="StartTime" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="form-field">
                        <label>Thời lượng (phút)</label>
                        <input type="number" name="DurationMinutes" value="30" min="15" step="15" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                <button type="submit" class="btn btn-primary-sm">Tạo đặt trước</button>
            </div>
        </form>
    </div>
</div>

@model TopUpPackageListViewModel
@inject ChauThanhEV.Services.MockDataService DataService
@{
    ViewData["Title"] = "Gói nạp tiền";
    ViewData["HeaderTag"] = "Chính sách ưu đãi nạp tiền ví điện tử xe điện";
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) routeValues["keyword"] = Model.Keyword;
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeValues["status"] = Model.StatusFilter;

    var totalPkgs = DataService.TopUpPackages.Count;
    var activePkgs = DataService.TopUpPackages.Count(p => p.Active);
}

<!-- KPI Metric Cards Strip -->
<div class="subpage-kpi-grid">
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-blue">🎁</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tổng số gói nạp ưu đãi</div>
            <div class="subpage-kpi-val">@totalPkgs <span style="font-size:13px; font-weight:600; color:#64748b;">gói</span></div>
            <div class="subpage-kpi-sub">Cấu hình khuyến mãi nạp ví</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-green">🟢</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Gói đang áp dụng</div>
            <div class="subpage-kpi-val">@activePkgs <span style="font-size:13px; font-weight:600; color:#64748b;">gói</span></div>
            <div class="subpage-kpi-sub">Hiển thị trên App khách hàng</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-orange">⭐</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Mức ưu đãi tối đa</div>
            <div class="subpage-kpi-val">+20% <span style="font-size:13px; font-weight:600; color:#64748b;">giá trị nạp</span></div>
            <div class="subpage-kpi-sub">Gói Doanh Nghiệp / Taxi EV</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-purple">⚡</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Mệnh giá phổ biến</div>
            <div class="subpage-kpi-val" style="font-size: 16px;">1M – 5M VNĐ</div>
            <div class="subpage-kpi-sub">Tích lũy điểm sạc cao tốc</div>
        </div>
    </div>
</div>

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo tên gói nạp..." />
    </form>

    <form method="get" class="filter-select-form">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <input type="hidden" name="keyword" value="@Model.Keyword" />
        }
        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">Tất cả trạng thái</option>
            <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang hoạt động</option>
            <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Tạm dừng</option>
        </select>
    </form>

    <div class="toolbar-actions">
        <button type="button" class="btn btn-outline" data-export-csv="packageTable" data-export-name="danh-sach-goi-nap-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất CSV
        </button>
        <button type="button" class="btn btn-outline" data-export-excel="packageTable" data-export-name="danh-sach-goi-nap-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất Excel
        </button>
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-create-package">
            @await Html.PartialAsync("_Icon", "plus") Thêm gói nạp
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="packageTable">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên gói nạp</th>
                    <th>Mệnh giá nạp</th>
                    <th>Thưởng / Ưu đãi</th>
                    <th>Trạng thái</th>
                    <th class="no-export">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr class="empty-row"><td colspan="6">Không có gói nạp tiền nào.</td></tr>
                }
                @for (int i = 0; i < Model.Result.Items.Count; i++)
                {
                    var pkg = Model.Result.Items[i];
                    <tr>
                        <td>@((Model.Result.Page - 1) * Model.Result.PageSize + i + 1)</td>
                        <td><strong>@pkg.Name</strong></td>
                        <td>@ChauThanhEV.Services.MockDataService.FormatCurrency(pkg.Amount)</td>
                        <td><span style="color:#059669; font-weight:700;">+@ChauThanhEV.Services.MockDataService.FormatCurrency(pkg.Bonus)</span></td>
                        <td>
                            <span class="pill @(pkg.Active ? "pill-green" : "pill-gray")">@(pkg.Active ? "Đang hoạt động" : "Tạm dừng")</span>
                        </td>
                        <td class="no-export">
                            <div class="cell-actions">
                                <button type="button" class="btn btn-ghost btn-sm" data-open-modal="modal-edit-package-@pkg.Id" title="Sửa gói nạp">@await Html.PartialAsync("_Icon", "edit")</button>
                                <form asp-action="Delete" asp-controller="TopUpPackages" method="post" data-confirm="Xóa gói @pkg.Name?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pkg.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Xóa">@await Html.PartialAsync("_Icon", "trash")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        TotalItems = Model.Result.TotalItems,
        PageSize = Model.Result.PageSize,
        Controller = "TopUpPackages",
        Action = "Index",
        RouteValues = routeValues
    })
</div>

<div class="modal-overlay" id="modal-create-package">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Thêm gói nạp tiền mới</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="TopUpPackages" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field full">
                        <label>Tên gói nạp</label>
                        <input type="text" name="Name" required placeholder="Vd: Gói nạp xe dịch vụ 500k" />
                    </div>
                    <div class="form-field">
                        <label>Mệnh giá (VNĐ)</label>
                        <input type="number" name="Amount" value="100000" min="10000" step="10000" required />
                    </div>
                    <div class="form-field">
                        <label>Tiền thưởng khuyến mãi (VNĐ)</label>
                        <input type="number" name="Bonus" value="0" min="0" step="5000" />
                    </div>
                    <div class="form-field full">
                        <label>Trạng thái</label>
                        <select name="Active">
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Tạm dừng</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                <button type="submit" class="btn btn-primary-sm">Lưu gói</button>
            </div>
        </form>
    </div>
</div>

@foreach (var pkg in Model.Result.Items)
{
    <div class="modal-overlay" id="modal-edit-package-@pkg.Id">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Sửa gói @pkg.Name</h3>
                <button type="button" class="modal-close" data-close-modal>&times;</button>
            </div>
            <form asp-controller="TopUpPackages" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@pkg.Id" />
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-field full">
                            <label>Tên gói nạp</label>
                            <input type="text" name="Name" value="@pkg.Name" required />
                        </div>
                        <div class="form-field">
                            <label>Mệnh giá (VNĐ)</label>
                            <input type="number" name="Amount" value="@((long)pkg.Amount)" min="10000" step="10000" required />
                        </div>
                        <div class="form-field">
                            <label>Tiền thưởng khuyến mãi (VNĐ)</label>
                            <input type="number" name="Bonus" value="@((long)pkg.Bonus)" min="0" step="5000" />
                        </div>
                        <div class="form-field full">
                            <label>Trạng thái</label>
                            <select name="Active">
                                <option value="true" selected="@(pkg.Active)">Đang hoạt động</option>
                                <option value="false" selected="@(!pkg.Active)">Tạm dừng</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                    <button type="submit" class="btn btn-primary-sm">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
}

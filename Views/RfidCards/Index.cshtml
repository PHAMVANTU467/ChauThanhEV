@model RfidCardListViewModel
@inject ChauThanhEV.Services.MockDataService DataService
@{
    ViewData["Title"] = "Quản lý thẻ RFID";
    ViewData["HeaderTag"] = "Thẻ RFID Mifare 13.56MHz đồng bộ trụ sạc DC";
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) routeValues["keyword"] = Model.Keyword;
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeValues["status"] = Model.StatusFilter;

    var totalCards = DataService.Cards.Count;
    var activeCards = DataService.Cards.Count(c => c.Status == CardStatus.Active);
    var lockedCards = DataService.Cards.Count(c => c.Status == CardStatus.Inactive);
}

<!-- KPI Metric Cards Strip -->
<div class="subpage-kpi-grid">
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-blue">@await Html.PartialAsync("_Icon", "card")</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Tổng số thẻ RFID</div>
            <div class="subpage-kpi-val">@totalCards <span style="font-size:13px; font-weight:600; color:#64748b;">thẻ</span></div>
            <div class="subpage-kpi-sub">Đã phát hành toàn mạng lưới</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-green">@await Html.PartialAsync("_Icon", "check")</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Thẻ đang hoạt động</div>
            <div class="subpage-kpi-val">@activeCards <span style="font-size:13px; font-weight:600; color:#64748b;">thẻ</span></div>
            <div class="subpage-kpi-sub">@((activeCards * 100.0 / totalCards).ToString("0.0"))% sẵn sàng quẹt sạc xe</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-orange">@await Html.PartialAsync("_Icon", "lock")</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Thẻ tạm khóa / Báo mất</div>
            <div class="subpage-kpi-val">@lockedCards <span style="font-size:13px; font-weight:600; color:#64748b;">thẻ</span></div>
            <div class="subpage-kpi-sub">Ngăn ngừa quẹt sạc trái phép</div>
        </div>
    </div>
    <div class="subpage-kpi-card">
        <div class="subpage-kpi-icon bg-purple">@await Html.PartialAsync("_Icon", "power")</div>
        <div class="subpage-kpi-info">
            <div class="subpage-kpi-label">Chuẩn giao tiếp vô tuyến</div>
            <div class="subpage-kpi-val" style="font-size: 16px;">Mifare 13.56 MHz</div>
            <div class="subpage-kpi-sub">Tương thích đầu đọc trụ DC</div>
        </div>
    </div>
</div>

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo mã thẻ, người dùng, SĐT..." />
    </form>

    <form method="get" class="filter-select-form">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <input type="hidden" name="keyword" value="@Model.Keyword" />
        }
        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">Tất cả trạng thái</option>
            <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang hoạt động</option>
            <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Đã khóa</option>
        </select>
    </form>

    <div class="toolbar-actions">
        <button type="button" class="btn btn-outline" data-export-csv="cardTable" data-export-name="danh-sach-the-rfid-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất CSV
        </button>
        <button type="button" class="btn btn-outline" data-export-excel="cardTable" data-export-name="danh-sach-the-rfid-chauthanh-ev">
            @await Html.PartialAsync("_Icon", "download") Xuất Excel
        </button>
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-create-card">
            @await Html.PartialAsync("_Icon", "plus") Thêm thẻ RFID
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="cardTable">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Mã thẻ RFID</th>
                    <th>Chủ thẻ (Khách hàng)</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Ngày hết hạn</th>
                    <th class="no-export">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr class="empty-row"><td colspan="7">Không có thẻ RFID nào.</td></tr>
                }
                @for (int i = 0; i < Model.Result.Items.Count; i++)
                {
                    var card = Model.Result.Items[i];
                    <tr>
                        <td>@((Model.Result.Page - 1) * Model.Result.PageSize + i + 1)</td>
                        <td><strong>@card.CardId</strong></td>
                        <td>@card.UserName</td>
                        <td><span class="pill @(card.Status == CardStatus.Active ? "pill-green" : "pill-gray")">@(card.Status == CardStatus.Active ? "Đang hoạt động" : "Đã khóa")</span></td>
                        <td>@card.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td>@card.ExpiryDate.ToString("dd/MM/yyyy")</td>
                        <td class="no-export">
                            <div class="cell-actions">
                                <form asp-action="ToggleStatus" asp-controller="RfidCards" method="post" data-confirm="Cập nhật trạng thái thẻ @card.CardId?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@card.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Khóa / Mở khóa">@await Html.PartialAsync("_Icon", "power")</button>
                                </form>
                                <form asp-action="Delete" asp-controller="RfidCards" method="post" data-confirm="Xóa thẻ @card.CardId?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@card.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Xóa">@await Html.PartialAsync("_Icon", "trash")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        TotalItems = Model.Result.TotalItems,
        PageSize = Model.Result.PageSize,
        Controller = "RfidCards",
        Action = "Index",
        RouteValues = routeValues
    })
</div>

<div class="modal-overlay" id="modal-create-card">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Thêm thẻ RFID mới</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="RfidCards" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field"><label>Mã thẻ RFID</label><input type="text" name="CardId" placeholder="Vd: RFID-2026-..." required /></div>
                    <div class="form-field">
                        <label>Chủ thẻ (Khách hàng)</label>
                        <select name="UserId">
                            @foreach (var u in Model.Customers)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="form-field full">
                        <label>Ngày hết hạn</label>
                        <input type="date" name="ExpiryDate" value="@DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                <button type="submit" class="btn btn-primary-sm">Lưu thẻ RFID</button>
            </div>
        </form>
    </div>
</div>

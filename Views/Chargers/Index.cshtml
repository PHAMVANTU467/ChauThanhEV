@model ChargerListViewModel
@{
    ViewData["Title"] = "Quản lý trụ sạc";
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) routeValues["keyword"] = Model.Keyword;
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeValues["status"] = Model.StatusFilter;
}

<div class="list-toolbar">
    <form method="get" class="search-box">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo mã trụ, tên trụ, trạm..." />
    </form>

    <form method="get" class="filter-select-form">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <input type="hidden" name="keyword" value="@Model.Keyword" />
        }
        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">Tất cả trạng thái</option>
            <option value="Online" selected="@(Model.StatusFilter == "Online")">Đang online</option>
            <option value="Offline" selected="@(Model.StatusFilter == "Offline")">Offline</option>
            <option value="Maintenance" selected="@(Model.StatusFilter == "Maintenance")">Đang bảo trì</option>
            <option value="Fault" selected="@(Model.StatusFilter == "Fault")">Có lỗi</option>
        </select>
    </form>

    <div class="toolbar-actions">
        <button type="button" class="btn btn-outline" data-export-csv="chargerTable" data-export-name="danh-sach-tru-sac">
            @await Html.PartialAsync("_Icon", "download") Xuất CSV
        </button>
        <button type="button" class="btn btn-outline" data-export-excel="chargerTable" data-export-name="danh-sach-tru-sac">
            @await Html.PartialAsync("_Icon", "download") Xuất Excel
        </button>
        <button type="button" class="btn btn-primary-sm" data-open-modal="modal-create-charger">
            @await Html.PartialAsync("_Icon", "plus") Thêm trụ sạc
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data-table" id="chargerTable">
            <thead>
                <tr>
                    <th>Mã trụ</th>
                    <th>Tên trụ</th>
                    <th>Trạm</th>
                    <th>Trạng thái</th>
                    <th>Cổng sạc (SD/Sạc/Lỗi)</th>
                    <th>Công suất</th>
                    <th>Ngày lắp đặt</th>
                    <th class="no-export">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr class="empty-row"><td colspan="8">Không tìm thấy trụ sạc phù hợp.</td></tr>
                }
                @foreach (var row in Model.Result.Items)
                {
                    <tr>
                        <td><strong>@row.Code</strong></td>
                        <td>@row.Name</td>
                        <td>@row.StationName</td>
                        <td>
                            @if (row.FilterStatus == "Online")
                            {
                                <span class="pill pill-green">Đang online</span>
                            }
                            else if (row.FilterStatus == "Offline")
                            {
                                <span class="pill pill-gray">Offline</span>
                            }
                            else if (row.FilterStatus == "Maintenance")
                            {
                                <span class="pill pill-orange">Đang bảo trì</span>
                            }
                            else
                            {
                                <span class="pill pill-red">Có lỗi</span>
                            }
                        </td>
                        <td>@row.AvailableCount / @row.ChargingCount / @row.FaultCount (Tổng @row.ConnectorCount)</td>
                        <td>@row.PowerKw kW</td>
                        <td>@row.InstallDate.ToString("dd/MM/yyyy")</td>
                        <td class="no-export">
                            <div class="cell-actions">
                                <button type="button" class="btn btn-ghost btn-sm" data-open-modal="modal-view-charger-@row.Id" title="Xem chi tiết">@await Html.PartialAsync("_Icon", "eye")</button>
                                <button type="button" class="btn btn-ghost btn-sm" data-open-modal="modal-edit-charger-@row.Id" title="Sửa">@await Html.PartialAsync("_Icon", "edit")</button>
                                <form asp-action="Delete" method="post" data-confirm="Xóa trụ sạc @row.Code khỏi hệ thống?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Xóa">@await Html.PartialAsync("_Icon", "trash")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        TotalItems = Model.Result.TotalItems,
        PageSize = Model.Result.PageSize,
        Controller = "Chargers",
        Action = "Index",
        RouteValues = routeValues
    })
</div>

<!-- Modal: Thêm trụ sạc -->
<div class="modal-overlay" id="modal-create-charger">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Thêm trụ sạc mới</h3>
            <button type="button" class="modal-close" data-close-modal>&times;</button>
        </div>
        <form asp-controller="Chargers" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field full">
                        <label>Tên trụ sạc</label>
                        <input type="text" name="Name" required placeholder="Vd: Trụ sạc số 29" />
                    </div>
                    <div class="form-field">
                        <label>Trạm</label>
                        <select name="StationId">
                            @foreach (var st in Model.Stations)
                            {
                                <option value="@st.Id">@st.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Trạng thái</label>
                        <select name="Status">
                            <option value="Online">Đang hoạt động (Online)</option>
                            <option value="Offline">Ngoại tuyến (Offline)</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Công suất (kW)</label>
                        <input type="number" name="PowerKw" value="60" min="1" step="1" />
                    </div>
                    <div class="form-field">
                        <label>Số cổng sạc</label>
                        <input type="number" name="ConnectorCount" value="2" min="1" max="4" />
                        <p class="form-hint">Các cổng mới tạo mặc định ở trạng thái Sẵn sàng (Available).</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                <button type="submit" class="btn btn-primary-sm">Lưu trụ sạc</button>
            </div>
        </form>
    </div>
</div>

@foreach (var row in Model.Result.Items)
{
    <!-- Modal: Xem chi tiết -->
    <div class="modal-overlay" id="modal-view-charger-@row.Id">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Chi tiết trụ sạc @row.Code</h3>
                <button type="button" class="modal-close" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <div class="detail-item"><label>Tên trụ</label><p>@row.Name</p></div>
                    <div class="detail-item"><label>Trạm</label><p>@row.StationName</p></div>
                    <div class="detail-item"><label>Trạng thái</label><p>@(row.FilterStatus == "Online" ? "Đang online" : row.FilterStatus == "Offline" ? "Offline" : row.FilterStatus == "Maintenance" ? "Đang bảo trì" : "Có lỗi")</p></div>
                    <div class="detail-item"><label>Công suất</label><p>@row.PowerKw kW</p></div>
                    <div class="detail-item"><label>Ngày lắp đặt</label><p>@row.InstallDate.ToString("dd/MM/yyyy")</p></div>
                    <div class="detail-item"><label>Tổng số cổng</label><p>@row.ConnectorCount cổng</p></div>
                    <div class="detail-item full">
                        <label>Danh sách cổng sạc</label>
                        <table class="data-table" style="margin-top:6px;">
                            <thead><tr><th>Mã cổng</th><th>Loại</th><th>Trạng thái</th></tr></thead>
                            <tbody>
                                @foreach (var conn in row.Connectors)
                                {
                                    <tr>
                                        <td>@conn.Code</td>
                                        <td>@conn.ConnectorType</td>
                                        <td>
                                            @if (conn.Status == ConnectorStatus.Available)
                                            {
                                                <span class="pill pill-green">Đang sẵn sàng</span>
                                            }
                                            else if (conn.Status == ConnectorStatus.Charging)
                                            {
                                                <span class="pill pill-blue">Đang sạc</span>
                                            }
                                            else if (conn.Status == ConnectorStatus.Maintenance)
                                            {
                                                <span class="pill pill-orange">Đang bảo trì</span>
                                            }
                                            else
                                            {
                                                <span class="pill pill-red">Lỗi</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-close-modal>Đóng</button>
            </div>
        </div>
    </div>

    <!-- Modal: Sửa trụ sạc -->
    <div class="modal-overlay" id="modal-edit-charger-@row.Id">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Sửa trụ sạc @row.Code</h3>
                <button type="button" class="modal-close" data-close-modal>&times;</button>
            </div>
            <form asp-controller="Chargers" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@row.Id" />
                <input type="hidden" name="Code" value="@row.Code" />
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-field full">
                            <label>Tên trụ sạc</label>
                            <input type="text" name="Name" value="@row.Name" required />
                        </div>
                        <div class="form-field">
                            <label>Trạm</label>
                            <select name="StationId">
                                @foreach (var st in Model.Stations)
                                {
                                    <option value="@st.Id" selected="@(row.StationId == st.Id)">@st.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Trạng thái</label>
                            <select name="Status">
                                <option value="Online" selected="@(row.Status == ChargerStatus.Online)">Đang hoạt động (Online)</option>
                                <option value="Offline" selected="@(row.Status == ChargerStatus.Offline)">Ngoại tuyến (Offline)</option>
                                <option value="Maintenance" selected="@(row.Status == ChargerStatus.Maintenance)">Đang bảo trì</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Công suất (kW)</label>
                            <input type="number" name="PowerKw" value="@row.PowerKw" min="1" step="1" />
                        </div>
                        <div class="form-field">
                            <label>Số cổng sạc</label>
                            <input type="number" name="ConnectorCount" value="@row.ConnectorCount" min="1" max="4" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-close-modal>Hủy</button>
                    <button type="submit" class="btn btn-primary-sm">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
}

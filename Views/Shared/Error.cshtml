@model ChauThanhEV.Models.ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
    Layout = "_Layout";
}

<div class="table-card" style="padding: 48px 32px; text-align: center; max-width: 680px; margin: 40px auto;">
    <div style="font-size: 54px; margin-bottom: 16px;">⚠️</div>
    <h2 class="section-title" style="font-size: 22px; margin-bottom: 10px;">Đã xảy ra lỗi trong quá trình xử lý</h2>
    <p class="page-description" style="margin-bottom: 24px;">Hệ thống đã ghi nhận thông tin sự cố. Vui lòng thử lại hoặc quay về trang chủ.</p>

    @if (Model?.ShowRequestId == true)
    {
        <div style="background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border); display: inline-block; margin-bottom: 24px; font-family: monospace; font-size: 13px;">
            Mã định danh yêu cầu (Request ID): <strong>@Model.RequestId</strong>
        </div>
    }

    <div style="display: flex; gap: 12px; justify-content: center;">
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary-sm">
            @await Html.PartialAsync("_Icon", "bolt") Quay về Trang chủ
        </a>
        <button type="button" class="btn btn-outline" onclick="window.history.back()">
            Quay lại trang trước
        </button>
    </div>
</div>

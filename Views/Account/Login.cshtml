@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - CHÂU THÀNH EV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-shell">
        <section class="login-visual">
            <div class="login-brand">
                <div class="brand-logo-circle">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="#ffffff"/>
                    </svg>
                </div>
                <span>CHÂU THÀNH <b>EV</b></span>
            </div>

            <div class="login-illustration">
                <img src="~/images/ev_charging_stations.png" alt="Trạm sạc xe điện Châu Thành EV" class="charging-stations-img" />
            </div>
        </section>

        <section class="login-panel">
            <div class="login-card">
                <div class="login-card-logo">
                    <div class="brand-logo-circle large">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="#ffffff"/>
                        </svg>
                    </div>
                </div>
                <h1>Đăng nhập hệ thống</h1>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="form-alert">
                        @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label asp-for="Username">Tài khoản</label>
                        <div class="input-with-icon">
                            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.4" fill="currentColor"/><path d="M5 19c1.3-4 4-6 7-6s5.7 2 7 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                            <input asp-for="Username" placeholder="Nhập tài khoản" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="input-with-icon">
                            <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="10" rx="2.2" stroke="currentColor" stroke-width="1.7"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                            <input asp-for="Password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                            <button type="button" class="toggle-password" aria-label="Hiện mật khẩu">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="field-row">
                        <label class="checkbox-label">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>Ghi nhớ đăng nhập</span>
                        </label>
                        <a href="#" class="forgot-link">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-primary btn-block">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M10 17l5-5-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 12h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M20 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        Đăng nhập
                    </button>

                    <p class="demo-hint">Tài khoản demo: <strong>admin</strong> &nbsp;·&nbsp; Mật khẩu: <strong>admin123</strong></p>
                </form>
            </div>
        </section>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

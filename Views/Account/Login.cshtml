@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - CHÂU THÀNH EV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/images/chauthanhpetro.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/chauthanhpetro.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-shell">
        <!-- Visual section: Hero Charging Station Image (Phóng to tối đa, nổi bật) -->
        <section class="login-visual">
            <div class="login-visual-ambient"></div>

            <div class="login-brand">
                <img src="~/images/chauthanhpetro.png" alt="Châu Thành Petro" class="login-brand-logo-img" asp-append-version="true" />
                <div class="login-brand-text">
                    <span>CHÂU THÀNH <b>EV</b></span>
                    <small>Hệ thống Quản lý &amp; Vận hành Trạm Sạc Xe Điện Cao Tốc</small>
                </div>
            </div>

            <div class="login-illustration">
                <div class="hero-image-wrapper">
                    <img src="~/images/ev_charging_stations.png" alt="Hệ thống trạm sạc xe điện Châu Thành EV" class="charging-stations-img" />
                    
                    <!-- Floating Tech Specs Badges -->
                    <div class="floating-badge badge-top-right">
                        <span class="badge-icon">@await Html.PartialAsync("_Icon", "bolt")</span>
                        <div>
                            <strong>160kW – 240kW</strong>
                            <small>DC Fast Charging</small>
                        </div>
                    </div>

                    <div class="floating-badge badge-bottom-left">
                        <span class="badge-icon pulse-icon">@await Html.PartialAsync("_Icon", "check")</span>
                        <div>
                            <strong>OCPP 1.6 / 2.0.1</strong>
                            <small>Giám sát Real-time 24/7</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="login-visual-footer">
                <div class="feature-tag">
                    <span class="dot bg-green"></span> Hạ tầng sạc nhanh tiêu chuẩn Quốc tế
                </div>
                <div class="feature-tag">
                    <span class="dot bg-blue"></span> Quản lý doanh thu &amp; điều phối tải thông minh
                </div>
            </div>
        </section>

        <!-- Login form panel -->
        <section class="login-panel">
            <div class="login-card">
                <div class="login-card-logo">
                    <img src="~/images/chauthanhpetro.png" alt="Châu Thành Petro" class="login-card-logo-img" asp-append-version="true" />
                </div>
                <h1>Đăng nhập hệ thống</h1>
                <p class="login-subtitle">Trung tâm điều hành và quản lý trạm sạc</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="form-alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        <span>@ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage</span>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label asp-for="Username">Tài khoản quản trị</label>
                        <div class="input-with-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.4" fill="currentColor"/><path d="M5 19c1.3-4 4-6 7-6s5.7 2 7 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                            <input asp-for="Username" placeholder="Nhập tên đăng nhập" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="input-with-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="10" rx="2.2" stroke="currentColor" stroke-width="1.7"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                            <input asp-for="Password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                            <button type="button" class="toggle-password" aria-label="Hiện mật khẩu">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="field-row">
                        <label class="checkbox-label">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>Ghi nhớ phiên đăng nhập</span>
                        </label>
                        <a href="#" class="forgot-link">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-primary btn-block">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M10 17l5-5-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 12h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M20 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        <span>Đăng nhập hệ thống</span>
                    </button>

                    <div class="demo-box">
                        <div class="demo-title">
                            <span class="badge-demo">DEMO</span> Thông tin tài khoản thử nghiệm
                        </div>
                        <div class="demo-credentials">
                            <span>Tài khoản: <strong>admin</strong></span>
                            <span>Mật khẩu: <strong>admin123</strong></span>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

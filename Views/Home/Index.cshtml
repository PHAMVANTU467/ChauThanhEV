@model ChauThanhEV.Models.DashboardViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="beny-dashboard-container">

    <!-- ================================================================
         SECTION 1: STATUS OF EV CHARGER
         ================================================================ -->
    <div class="beny-section-group">
        <h2 class="beny-sec-title">Status of EV Charger</h2>
        <div class="status-charger-strip">
            <div class="scs-col">
                <div class="scs-label">Number of EV Chargers</div>
                <div class="scs-value color-cyan"><a href="@Url.Action("Index", "Chargers")">@Model.TotalChargers</a></div>
            </div>
            <div class="scs-col">
                <div class="scs-label">Number of Off-line EV Charger</div>
                <div class="scs-value color-orange"><a href="@Url.Action("Index", "Operations", new { tab = "offline" })">@Model.OfflineChargers</a></div>
            </div>
            <div class="scs-col">
                <div class="scs-label">Number of Available Connector</div>
                <div class="scs-value color-teal"><a href="@Url.Action("Index", "Chargers")">@Model.AvailableConnectors</a></div>
            </div>
            <div class="scs-col">
                <div class="scs-label">Number of Charging Connector</div>
                <div class="scs-value color-green"><a href="@Url.Action("Index", "Orders")">@Model.ChargingConnectors</a></div>
            </div>
            <div class="scs-col">
                <div class="scs-label">Number of Reservation Connector</div>
                <div class="scs-value color-blue"><a href="@Url.Action("Index", "Reservations")">@Model.ReservationConnectors</a></div>
            </div>
            <div class="scs-col">
                <div class="scs-label">Number of Fault Connector</div>
                <div class="scs-value color-red"><a href="@Url.Action("Index", "Operations")">@Model.FaultConnectors</a></div>
            </div>
        </div>
    </div>

    <!-- ================================================================
         SECTION 2: OVERVIEW TODAY
         ================================================================ -->
    <div class="beny-section-group">
        <h2 class="beny-sec-title">Overview Today</h2>
        <div class="overview-tri-grid">
            <!-- Left: GMV with mini sparkline chart -->
            <div class="beny-card gmv-spark-card">
                <div class="bc-head-row">
                    <span class="bc-title">GMV</span>
                </div>
                <div class="bc-big-val color-red">@Model.TodayGmvValue</div>
                <div class="bc-subline">
                    <span class="sub-compare">Yesterday: @Model.TodayGmvCompare.Replace("Hôm qua: ", "")</span>
                    <span class="sub-ratio">Compared to Yesterday: <b class="@(Model.TodayGmvChange >= 0 ? "text-green" : "text-red")">@(Model.TodayGmvChange >= 0 ? "↑ +" : "↓ ")@(Model.TodayGmvChange.ToString("0.00"))%</b></span>
                </div>
                <div class="mini-sparkline-wrap">
                    <canvas id="todayGmvSparkline" height="95"></canvas>
                </div>
            </div>

            <!-- Middle: Stacked Total Income & Total Electricity -->
            <div class="stacked-card-col">
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Total Income</span>
                    </div>
                    <div class="bc-big-val color-teal">@Model.TotalIncomeToday.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Yesterday: @Model.TotalIncomeToday.CompareLabel</span>
                        <span class="sub-ratio">Compared to Yesterday: <b class="@(Model.TotalIncomeToday.IsPositive ? "text-green" : "text-red")">@(Model.TotalIncomeToday.IsPositive ? "↑ +" : "↓ ")@(Model.TotalIncomeToday.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Total Electricity</span>
                    </div>
                    <div class="bc-big-val color-cyan">@Model.TotalElectricityToday.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Yesterday: @Model.TotalElectricityToday.CompareLabel</span>
                        <span class="sub-ratio">Compared to Yesterday: <b class="@(Model.TotalElectricityToday.IsPositive ? "text-green" : "text-red")">@(Model.TotalElectricityToday.IsPositive ? "↑ +" : "↓ ")@(Model.TotalElectricityToday.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
            </div>

            <!-- Right: Stacked Numbers of Order & Active Users -->
            <div class="stacked-card-col">
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Numbers of Order</span>
                    </div>
                    <div class="bc-big-val color-cyan">@Model.NumbersOfOrderToday.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Yesterday: @Model.NumbersOfOrderToday.CompareLabel</span>
                        <span class="sub-ratio">Compared to Yesterday: <b class="@(Model.NumbersOfOrderToday.IsPositive ? "text-green" : "text-red")">@(Model.NumbersOfOrderToday.IsPositive ? "↑ +" : "↓ ")@(Model.NumbersOfOrderToday.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Active Users</span>
                    </div>
                    <div class="bc-big-val color-cyan">@Model.ActiveUsersTodayCard.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Yesterday: @Model.ActiveUsersTodayCard.CompareLabel</span>
                        <span class="sub-ratio">Compared to Yesterday: <b class="@(Model.ActiveUsersTodayCard.IsPositive ? "text-green" : "text-red")">@(Model.ActiveUsersTodayCard.IsPositive ? "↑ +" : "↓ ")@(Model.ActiveUsersTodayCard.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================
         SECTION 3: OVERVIEW MONTHLY
         ================================================================ -->
    <div class="beny-section-group">
        <h2 class="beny-sec-title">Overview Monthly</h2>
        <div class="overview-tri-grid">
            <!-- Left: GMV Monthly with mini sparkline chart -->
            <div class="beny-card gmv-spark-card">
                <div class="bc-head-row">
                    <span class="bc-title">GMV</span>
                </div>
                <div class="bc-big-val color-red">@Model.MonthGmvValue</div>
                <div class="bc-subline">
                    <span class="sub-compare">Last Month: @Model.MonthGmvCompare.Replace("Tháng trước: ", "")</span>
                    <span class="sub-ratio">Compared to Last Month: <b class="@(Model.MonthGmvChange >= 0 ? "text-green" : "text-red")">@(Model.MonthGmvChange >= 0 ? "↑ +" : "↓ ")@(Model.MonthGmvChange.ToString("0.00"))%</b></span>
                </div>
                <div class="mini-sparkline-wrap">
                    <canvas id="monthGmvSparkline" height="95"></canvas>
                </div>
            </div>

            <!-- Middle: Stacked Total Income & Total Electricity -->
            <div class="stacked-card-col">
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Total Income</span>
                    </div>
                    <div class="bc-big-val color-teal">@Model.TotalIncomeMonth.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Last Month: @Model.TotalIncomeMonth.CompareLabel</span>
                        <span class="sub-ratio">Compared to Last Month: <b class="@(Model.TotalIncomeMonth.IsPositive ? "text-green" : "text-red")">@(Model.TotalIncomeMonth.IsPositive ? "↑ +" : "↓ ")@(Model.TotalIncomeMonth.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Total Electricity</span>
                    </div>
                    <div class="bc-big-val color-cyan">@Model.TotalElectricityMonth.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Last Month: @Model.TotalElectricityMonth.CompareLabel</span>
                        <span class="sub-ratio">Compared to Last Month: <b class="@(Model.TotalElectricityMonth.IsPositive ? "text-green" : "text-red")">@(Model.TotalElectricityMonth.IsPositive ? "↑ +" : "↓ ")@(Model.TotalElectricityMonth.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
            </div>

            <!-- Right: Stacked Numbers of Order & Active Users -->
            <div class="stacked-card-col">
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Numbers of Order</span>
                    </div>
                    <div class="bc-big-val color-cyan">@Model.NumbersOfOrderMonth.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Last Month: @Model.NumbersOfOrderMonth.CompareLabel</span>
                        <span class="sub-ratio">Compared to Last Month: <b class="@(Model.NumbersOfOrderMonth.IsPositive ? "text-green" : "text-red")">@(Model.NumbersOfOrderMonth.IsPositive ? "↑ +" : "↓ ")@(Model.NumbersOfOrderMonth.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
                <div class="beny-card stacked-item-card">
                    <div class="bc-head-row">
                        <span class="bc-title">Active Users</span>
                    </div>
                    <div class="bc-big-val color-cyan">@Model.ActiveUsersMonthCard.Value</div>
                    <div class="bc-subline">
                        <span class="sub-compare">Last Month: @Model.ActiveUsersMonthCard.CompareLabel</span>
                        <span class="sub-ratio">Compared to Last Month: <b class="@(Model.ActiveUsersMonthCard.IsPositive ? "text-green" : "text-red")">@(Model.ActiveUsersMonthCard.IsPositive ? "↑ +" : "↓ ")@(Model.ActiveUsersMonthCard.ChangePercent.ToString("0.00"))%</b></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================
         SECTION 4: INCOME & ACTIVE USERS CHARTS
         ================================================================ -->
    <div class="beny-charts-grid">
        <!-- Income Chart Card -->
        <div class="beny-card chart-large-card">
            <div class="clc-head">
                <h3 class="clc-title">Income</h3>
                <div class="beny-tab-group" data-chart="revenueChart">
                    <button type="button" class="beny-tab-btn active" data-period="today">Today</button>
                    <button type="button" class="beny-tab-btn" data-period="7d">Last 7 days</button>
                    <button type="button" class="beny-tab-btn" data-period="30d">Last 30 days</button>
                    <button type="button" class="beny-tab-btn" data-period="90d">Last 90 days</button>
                </div>
            </div>
            <div class="clc-body">
                <canvas id="revenueChart" height="240"></canvas>
            </div>
        </div>

        <!-- Active Users Chart Card -->
        <div class="beny-card chart-large-card">
            <div class="clc-head">
                <h3 class="clc-title">Active Users</h3>
                <div class="beny-tab-group" data-chart="activeUsersChart">
                    <button type="button" class="beny-tab-btn active" data-period="today">Today</button>
                    <button type="button" class="beny-tab-btn" data-period="7d">Last 7 days</button>
                    <button type="button" class="beny-tab-btn" data-period="30d">Last 30 days</button>
                    <button type="button" class="beny-tab-btn" data-period="90d">Last 90 days</button>
                </div>
            </div>
            <div class="clc-body">
                <canvas id="activeUsersChart" height="240"></canvas>
            </div>
        </div>
    </div>

    <!-- ================================================================
         SECTION 5: 5 STATIONS FLEET MONITORING (40 CHARGERS - 80 PORTS)
         ================================================================ -->
    <div class="beny-section-group" style="margin-top: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <h2 class="beny-sec-title" style="margin-bottom: 0;">Station Fleet Overview (5 Stations • 40 Chargers • 80 Ports)</h2>
            <a href="@Url.Action("Index", "Stations")" class="btn btn-sm btn-outline-light" style="color: #00d2ff; border-color: rgba(0,210,255,0.4); background: rgba(0,210,255,0.08); font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 6px; text-decoration: none;">View All Stations &rarr;</a>
        </div>
        <div class="station-fleet-grid">
            @foreach (var station in Model.StationsList)
            {
                var total = station.TotalConnectors > 0 ? station.TotalConnectors : 16;
                var chgPct = (station.ChargingConnectors * 100.0) / total;
                var avlPct = (station.AvailableConnectors * 100.0) / total;
                var fltPct = (station.FaultConnectors * 100.0) / total;

                <div class="station-fleet-card">
                    <div class="sfc-head">
                        <div class="sfc-title">
                            <h4>@station.Name</h4>
                            <p class="sfc-addr">@station.Address</p>
                        </div>
                        <div class="sfc-power">1.600 kW</div>
                    </div>

                    <div class="sfc-metrics">
                        <div class="sfc-col">
                            <div class="lbl">Chargers</div>
                            <div class="val">@station.TotalChargers Trụ DC</div>
                        </div>
                        <div class="sfc-col">
                            <div class="lbl">Connectors</div>
                            <div class="val">@station.TotalConnectors Súng CCS2</div>
                        </div>
                        <div class="sfc-col">
                            <div class="lbl">Active Load</div>
                            <div class="val text-cyan">@station.ActivePowerKw.ToString("N0") kW</div>
                        </div>
                    </div>

                    <div class="sfc-connector-box">
                        <div class="scb-header">
                            <span class="scb-title">Ports Status</span>
                            <span class="scb-count">@station.ChargingConnectors Charging / @station.TotalConnectors Total</span>
                        </div>
                        <div class="connector-progress-bar">
                            <div class="cpb-seg charging" style="width: @chgPct.ToString("0.0")%" title="Charging: @station.ChargingConnectors"></div>
                            <div class="cpb-seg available" style="width: @avlPct.ToString("0.0")%" title="Available: @station.AvailableConnectors"></div>
                            <div class="cpb-seg offline" style="width: @fltPct.ToString("0.0")%" title="Offline/Fault: @station.FaultConnectors"></div>
                        </div>
                        <div class="sfc-legend">
                            <span><i class="leg-dot charging"></i> Charging (@station.ChargingConnectors)</span>
                            <span><i class="leg-dot available"></i> Available (@station.AvailableConnectors)</span>
                            <span><i class="leg-dot offline"></i> Maintenance (@station.FaultConnectors)</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script>
        window.__dashboardData = {
            revenue: {
                today: @Html.Raw(ViewBag.RevenueTodayJson ?? "{}"),
                d7:    @Html.Raw(ViewBag.Revenue7DaysJson ?? "{}"),
                d30:   @Html.Raw(ViewBag.Revenue30DaysJson ?? "{}"),
                d90:   @Html.Raw(ViewBag.Revenue90DaysJson ?? "{}")
            },
            activeUsers: {
                today: @Html.Raw(ViewBag.ActiveUsersTodayJson ?? "{}"),
                d7:    @Html.Raw(ViewBag.ActiveUsers7DaysJson ?? "{}"),
                d30:   @Html.Raw(ViewBag.ActiveUsers30DaysJson ?? "{}"),
                d90:   @Html.Raw(ViewBag.ActiveUsers90DaysJson ?? "{}")
            },
            todayGmvSparkline: @Html.Raw(ViewBag.TodayGmvSparklineJson ?? "{}"),
            monthGmvSparkline: @Html.Raw(ViewBag.MonthGmvSparklineJson ?? "{}"),
            doughnut: @Html.Raw(ViewBag.DoughnutJson ?? "{}")
        };
        if (typeof window.initDashboardCharts === 'function') {
            window.initDashboardCharts();
        }
    </script>
}
